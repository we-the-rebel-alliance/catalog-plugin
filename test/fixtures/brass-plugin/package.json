{
  "name": "@we-the-rebel-alliance/brass-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test target for catalog-plugin's host tests: one action, planned then committed, with the host-signed grant verified by its own register.",
  "exports": {
    "./server": "./index.js"
  },
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "brass",
      "title": "Brass",
      "summary": "A test target: one note, planned and then committed under a host-signed action grant.",
      "vendor": {
        "id": "brass",
        "name": "Brass",
        "domain": "brass.example"
      },
      "icons": [
        {
          "src": "assets/icon.svg",
          "type": "image/svg+xml"
        }
      ],
      "host": {
        "opencode": ">=2.4.1 <2.5.0",
        "tested": [
          "2.4.1"
        ]
      }
    },
    "options": {
      "type": "object",
      "properties": {
        "access": {
          "type": "string",
          "enum": [
            "all",
            "ask-changes",
            "read-only"
          ],
          "default": "all",
          "description": "How much the plugin's methods may do."
        },
        "allowUntestedHost": {
          "type": "boolean",
          "default": false,
          "description": "Start outside the tested OpenCode range."
        },
        "grant": {
          "type": "object",
          "description": "The host public key this test target verifies action grants with.",
          "properties": {
            "kid": {
              "type": "string"
            },
            "publicKey": {
              "type": "string"
            }
          },
          "required": [
            "kid",
            "publicKey"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "grant"
      ],
      "additionalProperties": false
    },
    "methods": {
      "status": {
        "class": "read",
        "accounts": "none"
      },
      "read_note": {
        "class": "read",
        "accounts": "none"
      },
      "plan_note": {
        "class": "read",
        "plans": true,
        "accounts": "none",
        "operations": [
          "brass.notes.write"
        ]
      },
      "save_note": {
        "class": "write",
        "commits": "plan_note",
        "accounts": "none",
        "operations": [
          "brass.notes.write"
        ]
      }
    },
    "sources": [],
    "actions": [
      {
        "id": "brass.note",
        "effect": "notify",
        "preview": "plan_note",
        "commit": "save_note",
        "input": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      }
    ],
    "events": {}
  }
}
